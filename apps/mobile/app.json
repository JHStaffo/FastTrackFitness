{
  "expo": {
    "name": "Fast Track Fitness",
    "slug": "fasttrackfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fasttrackems.fitness",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Fast Track Fitness reads your steps, sleep, workouts and water from Apple Health to score your daily wellness points.",
        "NSHealthUpdateUsageDescription": "Fast Track Fitness does not write to Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fasttrackems.fitness"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "fasttrackfitness"
  }
}
